+// Texture coordinates of vglTexCoordGen from the vector v of the coordinate array
+float3 generate_texcoord(int mode, float3 v, float4x4 modelview, float3x3 normal_mat, float4 eye_position) {
+	float3 result;
+	if (mode == 1) { // VGL_TEXCOORD_GEN_EYE_POSITION
+		result = mul(modelview, float4(v, 1.f)).xyz;
+	} else {
+#if normalization == 1
+		float3 normal = normalize(mul(normal_mat, v));
+#else
+		float3 normal = mul(normal_mat, v);
+#endif
+		if (mode == 2) { // VGL_TEXCOORD_GEN_EYE_NORMAL
+			result = normal;
+		} else { // VGL_TEXCOORD_GEN_EYE_REFLECTION
+			float3 incident = normalize(eye_position.xyz / eye_position.w);
+			result = incident - 2.f * dot(normal, incident) * normal;
+		}
+	}
+	return result;
+}
+#endif
